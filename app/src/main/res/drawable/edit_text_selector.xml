<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ESTADO DESHABILITADO (Gris oscuro y borde suave) -->
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#E0E0E0" /> <!-- Fondo Gris Claro -->
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#9E9E9E" /> <!-- Borde Gris -->
            <padding android:left="10dp" android:right="10dp" />
        </shape>
    </item>

    <!-- ESTADO NORMAL (Tu diseño original blanco) -->
    <item>
        <shape>
            <solid android:color="#FFFFFF" /> <!-- Fondo Blanco -->
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#BDBDBD" /> <!-- Borde Normal -->
            <padding android:left="10dp" android:right="10dp" />
        </shape>
    </item>
</selector>
