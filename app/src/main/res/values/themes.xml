<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Prueba" parent="Theme.Material3.Light.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="android:statusBarColor">#388E3C</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Prueba" parent="Base.Theme.Prueba" />

    <!-- CORRECCIÓN: Se agrega parent="Theme.Prueba" para que herede la configuración necesaria -->
    <style name="Theme.Prueba.NoActionBar" parent="Theme.Prueba">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.Prueba.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.Prueba.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

</resources>